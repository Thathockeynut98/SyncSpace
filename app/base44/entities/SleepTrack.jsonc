{
  "name": "SleepTrack",
  "type": "object",
  "properties": {
    "space_id": {
      "type": "string",
      "description": "The shared space this sleep sound belongs to"
    },
    "kind": {
      "type": "string",
      "description": "Whether this is an uploaded audio file or the Spotify player",
      "enum": [
        "audio",
        "spotify"
      ],
      "default": "audio"
    },
    "title": {
      "type": "string",
      "description": "What the two of you call this sound"
    },
    "file_uri": {
      "type": "string",
      "description": "Private storage location of the uploaded audio"
    },
    "url": {
      "type": "string",
      "description": "The Spotify player address, when this is the Spotify player"
    },
    "order": {
      "type": "number",
      "description": "Where this sits in the soundtrack"
    },
    "added_by_name": {
      "type": "string",
      "description": "Display name of whoever added it"
    },
    "added_by_id": {
      "type": "string",
      "description": "User id of whoever added it"
    }
  },
  "required": [
    "space_id",
    "kind"
  ]
}