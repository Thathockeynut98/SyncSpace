{
  "name": "Memory",
  "type": "object",
  "properties": {
    "space_id": {
      "type": "string",
      "description": "The shared space this memory belongs to"
    },
    "text": {
      "type": "string",
      "description": "Plain memory text, kept only for memories saved before encryption"
    },
    "cipher": {
      "type": "string",
      "description": "The memory text scrambled with this space's key before it was saved"
    },
    "iv": {
      "type": "string",
      "description": "Random starting value used to scramble this one memory"
    },
    "photo_uri": {
      "type": "string",
      "description": "Private storage location of a photo kept with this memory"
    },
    "author_name": {
      "type": "string",
      "description": "Display name of whoever remembered it"
    },
    "author_id": {
      "type": "string",
      "description": "User id of whoever remembered it"
    }
  },
  "required": [
    "space_id"
  ]
}