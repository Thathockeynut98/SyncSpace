{
  "name": "CanvasDoc",
  "type": "object",
  "properties": {
    "space_id": {
      "type": "string",
      "description": "The shared space this drawing belongs to"
    },
    "layers": {
      "type": "array",
      "description": "The stack of layers, bottom first, each holding the marks made on it",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Stable id of this layer"
          },
          "name": {
            "type": "string",
            "description": "What this layer is called"
          },
          "hidden": {
            "type": "boolean",
            "description": "Whether this layer is currently hidden"
          },
          "opacity": {
            "type": "number",
            "description": "How strongly this layer shows, 0 to 1"
          },
          "strokes": {
            "type": "array",
            "description": "Every mark on this layer, oldest first",
            "items": {
              "type": "object",
              "properties": {
                "t": {
                  "type": "string",
                  "description": "Which tool made this mark"
                },
                "c": {
                  "type": "string",
                  "description": "Colour of the mark"
                },
                "w": {
                  "type": "number",
                  "description": "Width of the mark"
                },
                "o": {
                  "type": "number",
                  "description": "Opacity the mark was made with"
                },
                "m": {
                  "type": "string",
                  "description": "Mirror the mark was drawn under"
                },
                "e": {
                  "type": "string",
                  "description": "Stamp glyph, when this mark is a stamp"
                },
                "p": {
                  "type": "string",
                  "description": "Comma separated point list"
                },
                "a": {
                  "type": "number",
                  "description": "Seat of whoever made the mark"
                },
                "q": {
                  "type": "number",
                  "description": "Order the mark was made in"
                }
              }
            }
          }
        }
      }
    },
    "strokes": {
      "type": "array",
      "description": "Every stroke of older drawings, kept only so nothing drawn before layers is lost",
      "items": {
        "type": "object",
        "properties": {
          "c": {
            "type": "string",
            "description": "Stroke colour"
          },
          "w": {
            "type": "number",
            "description": "Stroke width"
          },
          "p": {
            "type": "string",
            "description": "Comma separated point list"
          }
        }
      }
    },
    "bg": {
      "type": "string",
      "description": "Colour of the paper the drawing sits on, as a hex colour"
    },
    "last_editor_name": {
      "type": "string",
      "description": "Who touched the drawing last"
    }
  },
  "required": [
    "space_id"
  ]
}