{
  "name": "Video",
  "type": "object",
  "properties": {
    "space_id": {
      "type": "string",
      "description": "The shared space this video belongs to"
    },
    "title": {
      "type": "string",
      "description": "What the two of you call this video"
    },
    "source": {
      "type": "string",
      "description": "Whether this was uploaded from a device or pasted as a link",
      "enum": [
        "upload",
        "link"
      ],
      "default": "upload"
    },
    "url": {
      "type": "string",
      "description": "The pasted link, when this is not an upload"
    },
    "file_uri": {
      "type": "string",
      "description": "Private storage location of the uploaded video"
    },
    "duration_seconds": {
      "type": "number",
      "description": "Length of the video in seconds"
    },
    "queued": {
      "type": "boolean",
      "description": "Whether this video is lined up in the watch queue",
      "default": false
    },
    "queue_order": {
      "type": "number",
      "description": "Where this video sits in the watch queue, lowest first"
    },
    "added_by_name": {
      "type": "string",
      "description": "Display name of whoever uploaded it"
    },
    "added_by_id": {
      "type": "string",
      "description": "User id of whoever uploaded it"
    }
  },
  "required": [
    "space_id",
    "title"
  ]
}