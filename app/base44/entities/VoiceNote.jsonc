{
  "name": "VoiceNote",
  "type": "object",
  "properties": {
    "space_id": {
      "type": "string",
      "description": "The shared space this voice note was left in"
    },
    "file_uri": {
      "type": "string",
      "description": "Private storage location of the recorded voice note"
    },
    "duration_seconds": {
      "type": "number",
      "description": "How long the recording runs, in seconds"
    },
    "author_name": {
      "type": "string",
      "description": "Display name of whoever recorded it"
    },
    "author_id": {
      "type": "string",
      "description": "User id of whoever recorded it"
    }
  },
  "required": [
    "space_id",
    "file_uri"
  ]
}