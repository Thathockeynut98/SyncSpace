{
  "name": "Heart",
  "type": "object",
  "properties": {
    "space_id": {
      "type": "string",
      "description": "The shared space this heart was sent in"
    },
    "from_id": {
      "type": "string",
      "description": "User id of whoever sent it"
    },
    "from_name": {
      "type": "string",
      "description": "Display name of whoever sent it"
    }
  },
  "required": [
    "space_id",
    "from_id"
  ]
}