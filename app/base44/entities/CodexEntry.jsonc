{
  "name": "CodexEntry",
  "type": "object",
  "properties": {
    "english": {
      "type": "string",
      "description": "The English word or phrase"
    },
    "vesperan": {
      "type": "string",
      "description": "The Vesperan word or phrase"
    },
    "english_lc": {
      "type": "string",
      "description": "Lowercase English, used for searching"
    },
    "vesperan_lc": {
      "type": "string",
      "description": "Lowercase Vesperan, used for searching"
    },
    "section": {
      "type": "string",
      "description": "Which part of the codex this entry belongs to, as shown"
    },
    "section_id": {
      "type": "string",
      "description": "Short id of that part of the codex"
    },
    "section_order": {
      "type": "number",
      "description": "Where that part sits in the codex"
    },
    "order": {
      "type": "number",
      "description": "Where this entry sits in the whole codex"
    }
  },
  "required": [
    "english",
    "vesperan",
    "section"
  ]
}