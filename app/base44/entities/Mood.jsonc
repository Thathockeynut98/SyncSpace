{
  "name": "Mood",
  "type": "object",
  "properties": {
    "space_id": {
      "type": "string",
      "description": "The shared space this mood belongs to"
    },
    "owner_id": {
      "type": "string",
      "description": "User id of whoever felt this way"
    },
    "owner_name": {
      "type": "string",
      "description": "Display name of whoever felt this way"
    },
    "day": {
      "type": "string",
      "description": "The calendar day this mood is for, as YYYY-MM-DD"
    },
    "mood": {
      "type": "string",
      "description": "Which feeling they picked for the day",
      "enum": [
        "glowing",
        "happy",
        "loved",
        "excited",
        "grateful",
        "calm",
        "dreamy",
        "missing",
        "tired",
        "anxious",
        "low",
        "stormy"
      ]
    },
    "note": {
      "type": "string",
      "description": "A few words about the day, if they wanted to say more"
    }
  },
  "required": [
    "space_id",
    "owner_id",
    "day",
    "mood"
  ]
}