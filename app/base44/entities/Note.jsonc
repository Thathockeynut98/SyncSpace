{
  "name": "Note",
  "type": "object",
  "properties": {
    "space_id": {
      "type": "string",
      "description": "The shared space this note was left in"
    },
    "text": {
      "type": "string",
      "description": "Plain note text, kept only for notes written before encryption"
    },
    "cipher": {
      "type": "string",
      "description": "The note text scrambled with this space's key before it was saved"
    },
    "iv": {
      "type": "string",
      "description": "Random starting value used to scramble this one note"
    },
    "color": {
      "type": "string",
      "description": "Tone of the sticky note",
      "enum": [
        "amber",
        "fuchsia",
        "emerald",
        "sky",
        "rose",
        "violet",
        "teal",
        "lime"
      ]
    },
    "author_name": {
      "type": "string",
      "description": "Display name of whoever wrote it"
    },
    "author_id": {
      "type": "string",
      "description": "User id of whoever wrote it"
    }
  },
  "required": [
    "space_id"
  ]
}